# deploy-time secrets (the services' JWTs)
.env
# ...but deploy/.env is the committed list of versions and ports, with no secrets
!deploy/.env

# dev-only JWTs used by `npm start` (each app also ignores its own)
**/src/environments/environment.development.ts

# build output and dependencies
node_modules/
dist/
.angular/
coverage/

.DS_Store
Thumbs.db
