// Checks and publishes the configurator-portal image (nginx, no app code, so no unit tests).
// Jenkins job: pipeline (or multibranch pipeline) on this repository, Script Path "configurator-portal/ci/Jenkinsfile".
// Image name: ${dockerRegistry}/${dockerRepo}/${project}/${component}:<version>
// The version comes from ${component}/VERSION ("-snapshot" is added on develop).
// process-orchestrator-ui/ci/Jenkinsfile is a copy of this file: keep them in step.
pipeline {

    agent {
      label 'onboarding'
    }

    environment {
        // CHANGE VARIABLES TO YOUR PROJECT
        //-----------------------------------------
        project = "components"
        // plain HTTP, as in the other pipelines: the agents cannot all reach the https URL of the "SonarQube" installation
        sonarUrl = "http://ci.dev.multicert.com/sonar/"
        sonarProjectNameSuffix = "branch"
        dockerRegistry = "nexus:8443"
        dockerRepo = "multicert"
        // Docker Hub mirror (the agents cannot reach Docker Hub): the tool images and the Dockerfiles' base images
        dockerMirror = "nexus:8440"
        httpsProxy = "http://proxy.multicert.dev:8080"
        noProxy = "localhost,multicert.inet,multicert.dev,forge.multicert.inet,ssl_ev_oa2,*.multicert.dev,*.pipelines.multicert.dev,*.dev.multicert.com"
        httpProxy = "http://proxy.multicert.dev:8080"
        // Jenkins job that deploys DEV; leave empty to skip the deploy stage
        deployDevJob = ""
        //-----------------------------------------
        // the folder this pipeline builds; also the image name and the Sonar project prefix
        component = "configurator-portal"
    }

    options {
        buildDiscarder(logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '', daysToKeepStr: '3', numToKeepStr: '5'))
        disableConcurrentBuilds()
    }

    stages {

      stage('Init and Check Version') {
        steps {
          script {
              def command="cat ./${component}/VERSION"
              env.version = sh(returnStdout: true, script: command).trim();
              env.versionSonar = env.version + "." + currentBuild.number

              // BRANCH_NAME is set only in multibranch jobs; a plain pipeline job has GIT_BRANCH ("origin/develop")
              env.branch = env.BRANCH_NAME ?: (env.GIT_BRANCH ?: "unknown").replaceFirst("^origin/", "")
              env.sonarProjectName = env.component + " " + env.branch.replaceAll("/(.*)", "") + " " + env.sonarProjectNameSuffix
              env.sonarProjectKey = env.component + "-" + env.branch.replaceAll("/(.*)", "")

              if (env.branch == "develop") {
                  env.version = env.version + "-snapshot"
              }

              env.image = "${dockerRegistry}/${dockerRepo}/${project}/${component}:${env.version}"
              echo "Project version: ${version}"
          }

          sh "docker version"
        }
      }

      // Settings in ${component}/sonar-project.properties. The Jenkins "SonarQube" installation and the
      // "SonarQubeToken" credential (as in the other components' pipelines) give the URL and the token.
      // As the agent's user the scanner cannot write its cache in the image, so SONAR_USER_HOME is in /tmp;
      // its work dir is in the workspace, where the Sonar plugin reads report-task.txt.
      // The Sonar server is reached directly at sonarUrl (plain http), on the agent's network: from a container's
      // own network it times out (worker02, http and https).
      stage('Sonar') {
        steps {
          // TEMPORARY: where the Sonar host resolves, on the agent and in a container; remove once Sonar passes on both agents
          sh "getent hosts ci.dev.multicert.com || true; docker run --rm ${dockerMirror}/node:24-alpine getent hosts ci.dev.multicert.com || true"
          withSonarQubeEnv(installationName: 'SonarQube', credentialsId: 'SonarQubeToken') {
          sh """SONAR_TOKEN="\$SONAR_AUTH_TOKEN" docker run --rm --network host --user \$(id -u):\$(id -g) \
             -e SONAR_HOST_URL='${sonarUrl}' -e SONAR_TOKEN -e SONAR_USER_HOME=/tmp/.sonar \
             -e SONAR_SCANNER_OPTS='-Dhttp.proxyHost=proxy.multicert.dev -Dhttp.proxyPort=8080 -Dhttps.proxyHost=proxy.multicert.dev -Dhttps.proxyPort=8080 -Dhttp.nonProxyHosts=localhost|*.multicert.dev|*.dev.multicert.com|*.multicert.inet' \
             -v "\$PWD/${component}":/usr/src ${dockerMirror}/sonarsource/sonar-scanner-cli \
             -Dsonar.projectKey='${env.sonarProjectKey}' \
             -Dsonar.projectName='${env.sonarProjectName}' \
             -Dsonar.projectVersion='${env.versionSonar}' \
             -Dsonar.working.directory=/usr/src/.scannerwork"""
          }
        }
      }

      stage('Build Docker') {
        steps {
          sh "echo version: ${version}"
          sh "docker build --build-arg BASE_REGISTRY='${dockerMirror}/' \
             --build-arg HTTP_PROXY='${httpProxy}' \
             --build-arg HTTPS_PROXY='${httpsProxy}' \
             --build-arg NO_PROXY='${noProxy}' \
             ${component} -t ${image}"
        }
      }

      stage('Publish to Docker Repo') {
        steps {
            withDockerRegistry([url: "https://${dockerRegistry}", credentialsId: 'nexus-credentials'])
            {
                sh "docker push ${image}"
            }
        }
      }

      stage('Deploy DEV') {
        when {
          allOf {
            expression { env.branch == "develop" }
            expression { env.deployDevJob?.trim() }
          }
        }
          steps {
              build job: env.deployDevJob, wait: true, parameters:[string(name: 'REQUESTED_ACTION', value: env.component)]
          }
      }
    }


    post {
        always {
            // remove the image built here, then the workspace
            script {
              if (env.image) {
                sh "docker image rm ${env.image} || true"
              }
            }
            deleteDir()
        }
    }
}
