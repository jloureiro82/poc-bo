# Rendered by the nginx image's envsubst step at startup (${PORTAL_WM_UI_URL} and ${PORTAL_PO_UI_URL} are filled in).
# The portal serves each micro frontend under its own path and strips that path before forwarding, so each app's
# container serves from / as it does on its own. Each app's container proxies its own /api to its own service and adds
# its own token: the portal never sees a token.
server {
  listen 80;
  server_name _;
  absolute_redirect off;
  root /usr/share/nginx/html;
  client_max_body_size 10m;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  add_header X-Frame-Options SAMEORIGIN always;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /workflows {
    return 301 /workflows/;
  }
  location /workflows/ {
    proxy_pass ${PORTAL_WM_UI_URL}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /workflows;
    proxy_read_timeout 130s;
  }

  location = /flows {
    return 301 /flows/;
  }
  location /flows/ {
    proxy_pass ${PORTAL_PO_UI_URL}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /flows;
    proxy_read_timeout 130s;
  }

  # the landing page
  location / {
    expires -1;
    try_files $uri $uri/ =404;
  }
}
