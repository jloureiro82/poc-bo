{
  "info": {
    "name": "scribe-service",
    "description": "Gerador de ata de reunião com IA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "scribe-service-mvp"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Atas",
      "item": [
        {
          "name": "Generate Ata",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/atas",
              "host": ["{{baseUrl}}"],
              "path": ["atas"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Reunião de planejamento Q3\",\n  \"transcript\": \"Ana: precisamos fechar o orçamento do Q3 até sexta.\\nBruno: consigo o número da infra hoje à tarde.\\nAna: ótimo, então sexta a gente revisa junto.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Actuator",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          },
          "response": []
        },
        {
          "name": "Metrics — Lista todas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "metrics"]
            }
          },
          "response": []
        },
        {
          "name": "Metrics — Duração chamada ao modelo (AI)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics/scribe.ai.call.duration",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "metrics", "scribe.ai.call.duration"]
            }
          },
          "response": []
        },
        {
          "name": "Metrics — Duração request end-to-end",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics/scribe.ata.request.duration",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "metrics", "scribe.ata.request.duration"]
            }
          },
          "response": []
        },
        {
          "name": "Metrics — Total de requisições",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics/scribe.ata.requests.total",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "metrics", "scribe.ata.requests.total"]
            }
          },
          "response": []
        },
        {
          "name": "Metrics — Tokens de prompt consumidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics/scribe.ai.tokens.prompt",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "metrics", "scribe.ai.tokens.prompt"]
            }
          },
          "response": []
        },
        {
          "name": "Metrics — Tokens de completion gerados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics/scribe.ai.tokens.completion",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "metrics", "scribe.ai.tokens.completion"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Swagger UI",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/swagger-ui.html",
          "host": ["{{baseUrl}}"],
          "path": ["swagger-ui.html"]
        }
      },
      "response": []
    }
  ]
}
