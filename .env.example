# Copy to .env (git-ignored) and fill in. Compose reads it for docker-compose.yml.

# Port the portal publishes on the host.
PORTAL_PORT=8080

# Image names: <IMAGE_PREFIX><name>:<IMAGE_TAG>. Set a registry prefix (with its trailing slash) to push,
# e.g. IMAGE_PREFIX=registry.example.com/configurators/
IMAGE_PREFIX=
IMAGE_TAG=latest

# workflow-manager: base URL with its context path, and the JWT nginx sends to it (without "Bearer ").
WM_BACKEND_URL=http://host.docker.internal:8081/workflowmanager
WM_TOKEN=

# process-orchestrator: base URL with its context path, and the JWT nginx sends to it (without "Bearer ").
PO_BACKEND_URL=http://host.docker.internal:8081/process-orchestrator
PO_TOKEN=
