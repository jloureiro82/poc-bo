# workflow-manager-ui: the service it calls, with its context path (workflow-manager runs on the host, WORKFLOW_MANAGER_PORT).
WM_BACKEND_URL=http://lxmtccomponentsd01.multicert.dev:8087/workflowmanager
# the path the portal serves it under, and the portal's apps for the top bar ("Name=url;Name=url")
APP_BASE_PATH=/workflows/
APP_LINKS=Workflow Configurator=/workflows/;Flow Configurator=/flows/
# JWT nginx sends to workflow-manager as "Authorization: Bearer ...", without "Bearer ". It never reaches the browser.
