# Rendered by the nginx image's envsubst step at startup (${WM_BACKEND_URL} and ${WM_TOKEN} are filled in).
# Does the same job as proxy.conf.json in development: the browser talks to one origin, so no CORS.
# nginx adds the token to every proxied call, so it never reaches the browser.
server {
  listen 80;
  server_name _;
  # behind a portal the app lives under a path; keep redirects relative so they stay under it
  absolute_redirect off;
  client_max_body_size 10m;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  location /api/ {
    proxy_pass ${WM_BACKEND_URL}/api/;
    proxy_set_header Host $proxy_host;
    proxy_set_header Authorization "Bearer ${WM_TOKEN}";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  location /management/ {
    proxy_pass ${WM_BACKEND_URL}/management/;
    proxy_set_header Host $proxy_host;
    proxy_set_header Authorization "Bearer ${WM_TOKEN}";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Hashed bundles never change; index.html must always be revalidated.
  location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location = /config.json {
    add_header Cache-Control "no-store";
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
